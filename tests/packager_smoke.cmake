if(NOT PACKER OR NOT TEST_ROOT)
    message(FATAL_ERROR "PACKER and TEST_ROOT are required")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/game")
file(WRITE "${TEST_ROOT}/game/main.lua" "function init() end\nfunction draw() end\n")
set(cart "${TEST_ROOT}/test.vcart")
execute_process(COMMAND "${PACKER}" -i "${TEST_ROOT}/game" -o "${cart}"
    -t "Smoke Test" --uuid "123e4567-e89b-42d3-a456-426614174000"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "sbee-pack failed (${result}): ${output} ${error}")
endif()
file(SIZE "${cart}" size)
if(size LESS 65)
    message(FATAL_ERROR "Cartridge file too small: ${size}")
endif()
# Compare binary bytes; text-mode reads may append a newline.
file(READ "${cart}" magic LIMIT 4 HEX)
if(NOT magic STREQUAL "53424545")
    message(FATAL_ERROR "Cartridge magic is not SBEE")
endif()
message(STATUS "packager smoke: created ${cart} (${size} bytes)")
