file(MAKE_DIRECTORY "${ROOT}/assets")
configure_file("${SOURCE_ROOT}/examples/data-demo/assets/bytes.bin" "${ROOT}/assets/bytes.bin" COPYONLY)
file(WRITE "${ROOT}/assets/text.txt" "Hello\ncartridge!\n")
file(WRITE "${ROOT}/empty" "")
file(WRITE "${ROOT}/one" "q")
string(REPEAT "x" 1048576 large)
file(WRITE "${ROOT}/large.bin" "${large}")
file(WRITE "${ROOT}/oversized" "${large}x")
string(SUBSTRING "${large}" 1 1048575 almost)
file(WRITE "${ROOT}/almost" "${almost}")
string(REPEAT "a" 239 longname)
file(WRITE "${ROOT}/${longname}" "long path")
file(WRITE "${ROOT}/module.lua" "return sugarbee.read_file('one')")
file(WRITE "${ROOT}/main.lua" "assert(require('module')=='q'); local s=sugarbee; top_bytes=assert(s.read_file('assets/bytes.bin')); assert(top_bytes==string.char(0,1,255,10,0,13)); function init() greeting=assert(s.read_file('assets/text.txt')) end; function update() assert(s.read_file('one')=='q') end; function draw() s.print(greeting,8,8) end; function shutdown() assert(s.read_file('one')=='q') end")
execute_process(COMMAND "${PACKER}" -i "${ROOT}" -o "${ROOT}.vcart" -t "Data Reader Tests" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Data fixture packaging failed")
endif()

file(WRITE "${ROOT}.vcart.invalid" "not a cartridge")
