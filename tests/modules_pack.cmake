file(MAKE_DIRECTORY "${ROOT}/nested" "${ROOT}/depth" "${ROOT}/count" "${ROOT}/large")
file(WRITE "${ROOT}/main.lua" "local v=require('value'); main_loaded=true; function init() initialized=(require('value')==v) end")
file(WRITE "${ROOT}/value.lua" "runs=(runs or 0)+1; return {answer=42, runs=runs}")
file(WRITE "${ROOT}/nested/child.lua" "return require('value')")
file(WRITE "${ROOT}/empty.lua" "")
string(REPEAT "a" 235 longname)
file(WRITE "${ROOT}/${longname}.lua" "return 5")
file(WRITE "${ROOT}/nothing.lua" "nil_runs=(nil_runs or 0)+1")
file(WRITE "${ROOT}/falsevalue.lua" "false_runs=(false_runs or 0)+1; return false")
file(WRITE "${ROOT}/scalar.lua" "return 17, 99")
file(WRITE "${ROOT}/callable.lua" "return function() return 23 end")
file(WRITE "${ROOT}/syntax.lua" "local = broken")
file(WRITE "${ROOT}/retry.lua" "attempts=(attempts or 0)+1; local b=require('value'); if attempts==1 then error('first attempt') end; return b")
file(WRITE "${ROOT}/objecterror.lua" "error(error_object)")
file(WRITE "${ROOT}/a.lua" "return require('b')")
file(WRITE "${ROOT}/b.lua" "if not break_cycle then return require('a') end; return 9")
file(WRITE "${ROOT}/runaway.lua" "while true do end")
file(WRITE "${ROOT}/work.lua" "local n=0; for i=1,80000 do n=n+i end; return n")
configure_file("${ROOT}/work.lua" "${ROOT}/workcopy.lua" COPYONLY)
configure_file("${ROOT}/work.lua" "${ROOT}/workprobe.lua" COPYONLY)
string(ASCII 27 esc)
file(WRITE "${ROOT}/binary.lua" "${esc}Lua")
foreach(i RANGE 1 17)
    math(EXPR next "${i}+1")
    if(i EQUAL 17)
        file(WRITE "${ROOT}/depth/m${i}.lua" "return 17")
    else()
        file(WRITE "${ROOT}/depth/m${i}.lua" "return require('depth.m${next}')")
    endif()
endforeach()
foreach(i RANGE 1 129)
    file(WRITE "${ROOT}/count/m${i}.lua" "return ${i}")
endforeach()
# Exactly 256 KiB of valid source; copies let the aggregate cap be tested.
string(REPEAT " " 262135 padding)
foreach(i RANGE 1 33)
    file(WRITE "${ROOT}/large/m${i}.lua" "return 1\n${padding}")
endforeach()
file(WRITE "${ROOT}/oversize.lua" "return 1\n${padding} ")
# Failed compilation still charges exactly 256 KiB.
file(WRITE "${ROOT}/badlarge.lua" "local = \n${padding}")
file(WRITE "${ROOT}/parent.lua" "require('count.m128'); return 1")
execute_process(COMMAND "${PACKER}" -i "${ROOT}" -o "${CART}" -t "Module Tests"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Module fixture packaging failed")
endif()
