file(MAKE_DIRECTORY "${ROOT}")
foreach(mode small medium wide large default absent bad oversized init_error draw_error)
    set(dir "${ROOT}/${mode}")
    file(MAKE_DIRECTORY "${dir}")
    set(w 300)
    set(h 200)
    if(mode STREQUAL medium)
        set(w 320)
        set(h 240)
    elseif(mode STREQUAL wide)
        set(w 640)
        set(h 360)
    elseif(mode STREQUAL large)
        set(w 960)
        set(h 720)
    elseif(mode STREQUAL default OR mode STREQUAL absent)
        set(w 1280)
        set(h 720)
    endif()
    file(WRITE "${dir}/console.json" "{\"video\":{\"width\":${w},\"height\":${h}}}")
    if(mode STREQUAL absent)
        file(REMOVE "${dir}/console.json")
    elseif(mode STREQUAL bad)
        file(WRITE "${dir}/console.json" "{\"video\":{\"width\":300,\"height\":240}}")
    elseif(mode STREQUAL oversized)
        string(REPEAT " " 4095 padding)
        file(WRITE "${dir}/console.json" "{}${padding}")
    endif()
    file(WRITE "${dir}/main.lua" "assert(sugarbee.width()==${w} and sugarbee.height()==${h}); function init() assert(sugarbee.width()==${w}) end; function update() assert(sugarbee.height()==${h}) end; function draw() sugarbee.cls(200,0,0) end; function shutdown() assert(sugarbee.width()==${w}) end")
    if(mode STREQUAL init_error)
        file(APPEND "${dir}/main.lua" "; function init() error('intentional init failure') end")
    elseif(mode STREQUAL draw_error)
        file(APPEND "${dir}/main.lua" "; function draw() error('intentional draw failure') end")
    endif()
    execute_process(COMMAND "${PACKER}" -i "${dir}" -o "${ROOT}/${mode}.vcart" -t "Canvas ${mode}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Canvas fixture packaging failed")
    endif()
endforeach()
