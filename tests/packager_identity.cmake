if(NOT PACKER OR NOT TEST_ROOT)
    message(FATAL_ERROR "PACKER and TEST_ROOT required")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/game/sub")
set(game "${TEST_ROOT}/game")
set(cart "${TEST_ROOT}/game.vcart")
set(uuid "123e4567-e89b-42d3-a456-426614174000")
file(WRITE "${game}/main.lua" "function init() end\n")
file(WRITE "${game}/sub/sugarbee.uuid" "ordinary game asset")
function(run expected)
    execute_process(COMMAND "${PACKER}" ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(expected STREQUAL "ok")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "Unexpected failure: ${out} ${err}")
        endif()
    elseif(result EQUAL 0)
        message(FATAL_ERROR "Unexpected success: ${ARGN}")
    endif()
endfunction()
run(fail -i "${game}" --init-identity --uuid invalid)
run(fail -i "${game}" --init-identity -o "${cart}")
if(EXISTS "${game}/sugarbee.uuid")
    message(FATAL_ERROR "Invalid initialization created metadata")
endif()
run(ok -i "${game}" --init-identity --uuid "${uuid}")
file(READ "${game}/sugarbee.uuid" identity)
if(NOT identity STREQUAL "${uuid}\n")
    message(FATAL_ERROR "Wrong persisted identity")
endif()
run(fail -i "${game}" --init-identity)
run(ok -i "${game}" -o "${cart}" -t First)
file(READ "${cart}" first OFFSET 16 LIMIT 16 HEX)
if(NOT first STREQUAL "123e4567e89b42d3a456426614174000")
    message(FATAL_ERROR "Wrong header identity")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${cart}"
    RESULT_VARIABLE listed OUTPUT_VARIABLE listing ERROR_VARIABLE error)
if(NOT listed EQUAL 0 OR listing MATCHES "(^|\n)sugarbee[.]uuid(\n|$)" OR
   NOT listing MATCHES "sub/sugarbee[.]uuid")
    message(FATAL_ERROR "Metadata exclusion failed: ${listing} ${error}")
endif()
file(APPEND "${game}/main.lua" "function draw() end\n")
run(ok -i "${game}" -o "${cart}" -t Updated)
file(READ "${cart}" second OFFSET 16 LIMIT 16 HEX)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "Rebuild changed save identity")
endif()
run(ok -i "${game}" -o "${cart}" -t Matching --uuid "123E4567-E89B-42D3-A456-426614174000")
file(SHA256 "${cart}" before)
run(fail -i "${game}" -o "${cart}" -t Conflict --uuid "223e4567-e89b-42d3-a456-426614174000")
foreach(bad IN ITEMS "" "garbage" "${uuid}\nextra" "123e4567-e89b-12d3-a456-426614174000" "${uuid}\r\n")
    file(WRITE "${game}/sugarbee.uuid" "${bad}")
    run(fail -i "${game}" -o "${cart}" -t Invalid --uuid "${uuid}")
endforeach()
file(SHA256 "${cart}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Rejected identity changed existing output")
endif()
file(REMOVE "${game}/sugarbee.uuid")
file(MAKE_DIRECTORY "${game}/sugarbee.uuid")
run(fail -i "${game}" -o "${cart}" -t Directory)
file(REMOVE_RECURSE "${game}/sugarbee.uuid")
file(CREATE_LINK "${TEST_ROOT}/missing" "${game}/sugarbee.uuid" SYMBOLIC)
run(fail -i "${game}" --init-identity)
run(fail -i "${game}" -o "${cart}" -t Symlink)
file(REMOVE "${game}/sugarbee.uuid")
run(ok -i "${game}" -o "${cart}" -t Legacy --uuid "${uuid}")
run(ok -i "${game}" -o "${cart}" -t LegacyRandom)
if(EXISTS "${game}/sugarbee.uuid")
    message(FATAL_ERROR "Ordinary packaging wrote source metadata")
endif()
run(ok -i "${game}" --init-identity)
file(READ "${game}/sugarbee.uuid" generated)
string(LENGTH "${generated}" size)
if(NOT size EQUAL 37)
    message(FATAL_ERROR "Generated UUID file has wrong size")
endif()
run(ok -i "${game}" -o "${cart}" -t Generated)
# Exact canonical UUID without newline is also accepted.
file(WRITE "${game}/sugarbee.uuid" "${uuid}")
run(ok -i "${game}" -o "${cart}" -t NoNewline)
message(STATUS "Identity initialization, adoption, rebuilds, exclusion and failures passed")
